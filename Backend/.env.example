# Frontend origin(s), comma-separated if more than one.
# Local development is also allowed by the backend CORS config.
FRONTEND_URL=https://food-delivery-rho-rosy.vercel.app

# Required for OTP and other transactional email.
# Add the real values to the Render service's Environment settings; never commit them.
BREVO_API_KEY=your_brevo_api_key
BREVO_VERIFIED_SENDER=your-verified-sender@example.com
